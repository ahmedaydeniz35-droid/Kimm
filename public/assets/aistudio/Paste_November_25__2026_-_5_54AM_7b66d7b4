                fontSize = 14.sp,
                color = TextMuted,
                modifier = Modifier.padding(top = 4.dp, bottom = 14.dp)
            )

            FourColumnBar(activeStepIndex = 0)

            Spacer(modifier = Modifier.height(16.dp))

            Row(
                verticalAlignment = Alignment.CenterVertically,
                horizontalArrangement = Arrangement.spacedBy(8.dp)
            ) {
                OutlinedTextField(
                    value = newName,
                    onValueChange = { newName = it },
                    placeholder = { Text("İsim yaz...") },
                    singleLine = true,
                    shape = RoundedCornerShape(14.dp),
                    colors = OutlinedTextFieldDefaults.colors(
                        focusedContainerColor = CardWhite,
                        unfocusedContainerColor = CardWhite
                    ),
                    modifier = Modifier.weight(1f)
                )
                FilledIconButton(
                    onClick = {
                        onAddPlayer(newName)
                        newName = ""
                    },
                    modifier = Modifier.size(54.dp),
                    shape = RoundedCornerShape(14.dp),
                    colors = IconButtonDefaults.filledIconButtonColors(containerColor = BrandIndigo)
                ) {
                    Icon(Icons.Default.PersonAdd, contentDescription = "Ekle", tint = Color.White)
                }
            }

            Spacer(modifier = Modifier.height(14.dp))

            LazyColumn(
                verticalArrangement = Arrangement.spacedBy(8.dp),
                modifier = Modifier.fillMaxSize()
            ) {
                itemsIndexed(players) { index, player ->
                    Surface(
                        shape = RoundedCornerShape(14.dp),
                        color = CardWhite,
                        shadowElevation = 1.dp,
                        modifier = Modifier.fillMaxWidth()
                    ) {
                        Row(
                            modifier = Modifier
                                .fillMaxWidth()
                                .padding(horizontal = 14.dp, vertical = 12.dp),
                            verticalAlignment = Alignment.CenterVertically,
                            horizontalArrangement = Arrangement.SpaceBetween
                        ) {
                            Row(verticalAlignment = Alignment.CenterVertically) {
                                Box(
                                    modifier = Modifier
                                        .size(28.dp)
                                        .clip(CircleShape)
                                        .background(BrandIndigoSoft),
                                    contentAlignment = Alignment.Center
                                ) {
                                    Text(
                                        text = "${index + 1}",
                                        color = BrandIndigo,
                                        fontWeight = FontWeight.Bold,
                                        fontSize = 13.sp
                                    )
                                }
                                Spacer(modifier = Modifier.width(10.dp))
                                Text(
                                    text = player.name,
                                    fontSize = 16.sp,
                                    fontWeight = FontWeight.SemiBold,
                                    color = TextInk
                                )
                            }

                            if (players.size > 2) {
                                IconButton(
                                    onClick = { onRemovePlayer(player.id) },
                                    modifier = Modifier.size(36.dp)
                                ) {
                                    Icon(
                                        Icons.Default.Close,
                                        contentDescription = "Kaldır",
                                        tint = Color(0xFFDC2626)
                                    )
                                }
                            }
                        }
                    }
                }
            }
        }

        Spacer(modifier = Modifier.height(12.dp))

        Button(
            onClick = onStartGame,
            modifier = Modifier
                .fillMaxWidth()
                .height(58.dp),
            shape = RoundedCornerShape(16.dp),
            colors = ButtonDefaults.buttonColors(containerColor = BrandIndigo)
        ) {
            Icon(Icons.Default.PlayArrow, contentDescription = null, modifier = Modifier.size(24.dp))
            Spacer(modifier = Modifier.width(8.dp))
            Text(
                text = "Oyuna Başla (${players.size} Kişi)",
                fontSize = 17.sp,
                fontWeight = FontWeight.Bold
            )
        }
    }
}

@Composable
private fun MobilePlayScreen(
    step: GameStep,
    player: Player,
    playerProgress: String,
    inputText: String,
    isHiddenLocked: Boolean,
    onInputChange: (String) -> Unit,
    onConfirmTick: () -> Unit
) {
    Column(
        modifier = Modifier
            .fillMaxSize()
            .statusBarsPadding()
            .navigationBarsPadding()
            .padding(horizontal = 16.dp, vertical = 14.dp),
        verticalArrangement = Arrangement.SpaceBetween
    ) {
        Column {
            FourColumnBar(activeStepIndex = step.index)

            Spacer(modifier = Modifier.height(18.dp))

            Row(
                modifier = Modifier.fillMaxWidth(),
                horizontalArrangement = Arrangement.SpaceBetween,
                verticalAlignment = Alignment.CenterVertically
            ) {
                Text(
                    text = "Sıra: ${player.name}",
                    fontSize = 18.sp,
                    fontWeight = FontWeight.Bold,
                    color = BrandIndigo
                )
                Surface(
                    shape = RoundedCornerShape(99.dp),
                    color = BrandIndigoSoft
                ) {
                    Text(
                        text = playerProgress,
                        color = BrandIndigo,
                        fontWeight = FontWeight.Bold,
                        fontSize = 13.sp,
                        modifier = Modifier.padding(horizontal = 12.dp, vertical = 5.dp)
                    )
                }
            }

            Spacer(modifier = Modifier.height(14.dp))

            Surface(
                shape = RoundedCornerShape(22.dp),
                color = CardWhite,
                shadowElevation = 2.dp,
                modifier = Modifier.fillMaxWidth()
            ) {
                Column(modifier = Modifier.padding(18.dp)) {
                    Text(
                        text = step.title,
                        fontSize = 26.sp,
                        fontWeight = FontWeight.ExtraBold,
                        color = TextInk
                    )

                    Spacer(modifier = Modifier.height(12.dp))

                    if (isHiddenLocked) {
                        Box(
                            modifier = Modifier
                                .fillMaxWidth()
                                .height(132.dp)
                                .clip(RoundedCornerShape(16.dp))
                                .background(TextInk),
                            contentAlignment = Alignment.Center
                        ) {
                            Column(horizontalAlignment = Alignment.CenterHorizontally) {
                                Icon(
                                    Icons.Default.VisibilityOff,
                                    contentDescription = null,
                                    tint = TickGreen,
                                    modifier = Modifier.size(34.dp)
                                )
                                Spacer(modifier = Modifier.height(8.dp))
                                Text(
                                    text = "Gizlendi ve Karışmaya Girdi",
                                    color = Color.White,
                                    fontWeight = FontWeight.Bold,
                                    fontSize = 15.sp
                                )
                            }
                        }
                    } else {
                        OutlinedTextField(
                            value = inputText,
                            onValueChange = onInputChange,
                            placeholder = { Text(step.hint, color = TextMuted) },
                            shape = RoundedCornerShape(16.dp),
                            textStyle = LocalTextStyle.current.copy(fontSize = 17.sp, color = TextInk),
                            modifier = Modifier
                                .fillMaxWidth()
                                .height(132.dp)
                        )
                    }
                }
            }
        }

        Button(
            onClick = onConfirmTick,
            enabled = inputText.isNotBlank() && !isHiddenLocked,
            modifier = Modifier
                .fillMaxWidth()
                .height(62.dp),
            shape = RoundedCornerShape(18.dp),
            colors = ButtonDefaults.buttonColors(containerColor = TickGreen)
        ) {
            Icon(Icons.Default.Check, contentDescription = "Okey", modifier = Modifier.size(28.dp))
            Spacer(modifier = Modifier.width(8.dp))
            Text(
                text = "Okey — Gizle ve Devam Et",
                fontSize = 17.sp,
                fontWeight = FontWeight.Bold
            )
        }
    }
}

