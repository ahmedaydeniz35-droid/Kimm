@Composable
private fun MobileResultsScreen(
    results: List<SentenceResult>,
    onPlayAgain: () -> Unit
) {
    var currentIndex by remember { mutableIntStateOf(0) }
    var showAll by remember { mutableStateOf(false) }

    Column(
        modifier = Modifier
            .fillMaxSize()
            .statusBarsPadding()
            .navigationBarsPadding()
            .padding(horizontal = 16.dp, vertical = 14.dp),
        verticalArrangement = Arrangement.SpaceBetween
    ) {
        Column(modifier = Modifier.weight(1f)) {
            FourColumnBar(activeStepIndex = 4)

            Spacer(modifier = Modifier.height(14.dp))

            Row(
                modifier = Modifier.fillMaxWidth(),
                horizontalArrangement = Arrangement.SpaceBetween,
                verticalAlignment = Alignment.CenterVertically
            ) {
                Text(
                    text = "Cümleler",
                    fontSize = 24.sp,
                    fontWeight = FontWeight.ExtraBold,
                    color = TextInk
                )
                FilledTonalButton(
                    onClick = { showAll = !showAll },
                    shape = RoundedCornerShape(12.dp)
                ) {
                    Text(if (showAll) "Tek Tek Oku" else "Tüm Liste")
                }
            }

            Spacer(modifier = Modifier.height(12.dp))

            if (!showAll && results.isNotEmpty()) {
                val item = results[currentIndex]

                Surface(
                    shape = RoundedCornerShape(24.dp),
                    color = ResultCardBg,
                    border = BorderStroke(1.5.dp, ResultCardBorder),
                    modifier = Modifier.fillMaxWidth()
                ) {
                    Column(modifier = Modifier.padding(22.dp)) {
                        Text(
                            text = "Okuyan: ${item.readerName} (${currentIndex + 1}/${results.size})",
                            color = BrandIndigo,
                            fontWeight = FontWeight.Bold,
                            fontSize = 14.sp
                        )
                        Spacer(modifier = Modifier.height(14.dp))
                        Text(
                            text = item.fullText,
                            fontSize = 23.sp,
                            fontWeight = FontWeight.ExtraBold,
                            color = TextInk,
                            lineHeight = 32.sp
                        )
                    }
                }

                Spacer(modifier = Modifier.height(14.dp))

                Row(
                    modifier = Modifier.fillMaxWidth(),
                    horizontalArrangement = Arrangement.spacedBy(10.dp)
                ) {
                    OutlinedButton(
                        onClick = { if (currentIndex > 0) currentIndex-- },
                        enabled = currentIndex > 0,
                        modifier = Modifier
                            .weight(1f)
                            .height(52.dp),
                        shape = RoundedCornerShape(14.dp)
                    ) {
                        Icon(Icons.Default.ArrowBack, contentDescription = null)
                        Spacer(modifier = Modifier.width(4.dp))
                        Text("Önceki")
                    }
                    Button(
                        onClick = { if (currentIndex + 1 < results.size) currentIndex++ },
                        enabled = currentIndex + 1 < results.size,
                        modifier = Modifier
                            .weight(1f)
                            .height(52.dp),
                        shape = RoundedCornerShape(14.dp),
                        colors = ButtonDefaults.buttonColors(containerColor = BrandIndigo)
                    ) {
                        Text("Sonraki")
                        Spacer(modifier = Modifier.width(4.dp))
                        Icon(Icons.Default.ArrowForward, contentDescription = null)
                    }
                }
            } else {
                LazyColumn(
                    verticalArrangement = Arrangement.spacedBy(8.dp),
                    modifier = Modifier.fillMaxSize()
                ) {
                    itemsIndexed(results) { idx, item ->
                        Surface(
                            shape = RoundedCornerShape(16.dp),
                            color = CardWhite,
                            shadowElevation = 1.dp,
                            modifier = Modifier.fillMaxWidth()
                        ) {
                            Column(modifier = Modifier.padding(14.dp)) {
                                Text(
                                    text = "${idx + 1}. ${item.readerName}",
                                    color = BrandIndigo,
                                    fontWeight = FontWeight.Bold,
                                    fontSize = 13.sp
                                )
                                Spacer(modifier = Modifier.height(4.dp))
                                Text(
                                    text = item.fullText,
                                    color = TextInk,
                                    fontWeight = FontWeight.SemiBold,
                                    fontSize = 16.sp
                                )
                            }
                        }
                    }
                }
            }
        }

        Spacer(modifier = Modifier.height(12.dp))

        Button(
            onClick = onPlayAgain,
            modifier = Modifier
                .fillMaxWidth()
                .height(56.dp),
            shape = RoundedCornerShape(16.dp),
            colors = ButtonDefaults.buttonColors(containerColor = TextInk)
        ) {
            Icon(Icons.Default.Refresh, contentDescription = null)
            Spacer(modifier = Modifier.width(8.dp))
            Text("Yeni Oyun", fontSize = 16.sp, fontWeight = FontWeight.Bold)
        }
    }
}
