private enum class ScreenState { LOBBY, PLAYING, SHUFFLING, RESULTS }

@Composable
private fun KimKiminleTelefonApp() {
    var screen by remember { mutableStateOf(ScreenState.LOBBY) }
    var players by remember {
        mutableStateOf(
            listOf(
                Player(UUID.randomUUID().toString(), "1. Kişi"),
                Player(UUID.randomUUID().toString(), "2. Kişi")
            )
        )
    }

    var currentStepIndex by remember { mutableIntStateOf(0) }
    var currentPlayerIndex by remember { mutableIntStateOf(0) }
    var inputText by remember { mutableStateOf("") }
    var isHiddenLocked by remember { mutableStateOf(false) }

    val answers = remember {
        mutableStateMapOf<GameStep, MutableMap<String, String>>().apply {
            GameStep.entries.forEach { put(it, mutableMapOf()) }
        }
    }

    var results by remember { mutableStateOf<List<SentenceResult>>(emptyList()) }

    when (screen) {
        ScreenState.LOBBY -> MobileLobbyScreen(
            players = players,
            onAddPlayer = { name ->
                if (name.isNotBlank()) {
                    players = players + Player(UUID.randomUUID().toString(), name.trim())
                }
            },
            onRemovePlayer = { id ->
                if (players.size > 2) {
                    players = players.filterNot { it.id == id }
                }
            },
            onStartGame = {
                GameStep.entries.forEach { answers[it]?.clear() }
                currentStepIndex = 0
                currentPlayerIndex = 0
                inputText = ""
                isHiddenLocked = false
                screen = ScreenState.PLAYING
            }
        )

        ScreenState.PLAYING -> {
            val step = GameStep.entries[currentStepIndex]
            val activePlayer = players[currentPlayerIndex]

            LaunchedEffect(isHiddenLocked) {
                if (isHiddenLocked) {
                    delay(850)
                    isHiddenLocked = false
                    inputText = ""
                    if (currentPlayerIndex + 1 < players.size) {
                        currentPlayerIndex++
                    } else {
                        screen = ScreenState.SHUFFLING
                    }
                }
            }

            MobilePlayScreen(
                step = step,
                player = activePlayer,
                playerProgress = "${currentPlayerIndex + 1}/${players.size}",
                inputText = inputText,
                isHiddenLocked = isHiddenLocked,
                onInputChange = { inputText = it },
                onConfirmTick = {
                    if (inputText.isNotBlank() && !isHiddenLocked) {
                        answers[step]?.put(activePlayer.id, inputText.trim())
                        isHiddenLocked = true
                    }
                }
            )
        }

        ScreenState.SHUFFLING -> {
            val finishedStep = GameStep.entries[currentStepIndex]
            LaunchedEffect(currentStepIndex) {
                delay(1400)
                if (currentStepIndex + 1 < GameStep.entries.size) {
                    currentStepIndex++
                    currentPlayerIndex = 0
                    screen = ScreenState.PLAYING
                } else {
                    results = GameShuffler.buildSentences(players, answers)
                    screen = ScreenState.RESULTS
                }
            }
            MobileShuffleScreen(finishedStepTitle = finishedStep.title)
        }

        ScreenState.RESULTS -> MobileResultsScreen(
            results = results,
            onPlayAgain = { screen = ScreenState.LOBBY }
        )
    }
}

@Composable
private fun FourColumnBar(activeStepIndex: Int) {
    Row(
        modifier = Modifier
            .fillMaxWidth()
            .clip(RoundedCornerShape(16.dp))
            .background(CardWhite)
            .padding(6.dp),
        horizontalArrangement = Arrangement.spacedBy(5.dp)
    ) {
        GameStep.entries.forEach { step ->
            val isActive = step.index == activeStepIndex
            val isDone = step.index < activeStepIndex

            val bg = when {
                isActive -> BrandIndigo
                isDone -> DoneGreenSoft
                else -> MobileBg
            }
            val fg = when {
                isActive -> Color.White
                isDone -> DoneGreenText
                else -> TextMuted
            }

            Box(
                modifier = Modifier
                    .weight(1f)
                    .clip(RoundedCornerShape(11.dp))
                    .background(bg)
                    .padding(vertical = 10.dp, horizontal = 2.dp),
                contentAlignment = Alignment.Center
            ) {
                Text(
                    text = step.title.removeSuffix("?"),
                    color = fg,
                    fontSize = 11.sp,
                    fontWeight = FontWeight.Bold,
                    maxLines = 1
                )
            }
        }
    }
}

@Composable
