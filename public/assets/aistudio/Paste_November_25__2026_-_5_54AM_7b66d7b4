private enum class GameStep(val index: Int, val title: String, val hint: String) {
    KIM(0, "Kim?", "Örn: Kırmızı şapkalı kedi, Kaptan..."),
    KIMINLE(1, "Kiminle?", "Örn: Uzaylılarla, iki penguenle..."),
    NEREDE(2, "Nerede?", "Örn: Mars'ta, okul bahçesinde..."),
    NE_YAPIYOR(3, "Ne Yapıyor?", "Örn: Halay çekiyor, dondurma yiyor...")
}

private data class Player(
    val id: String = "",
    val name: String = ""
)

private data class SentenceResult(
    val readerName: String,
    val kim: String,
    val kiminle: String,
    val nerede: String,
    val neYapiyor: String
) {
    val fullText: String
        get() = "$kim, $kiminle birlikte $nerede $neYapiyor!"
}

private object GameShuffler {
    fun buildSentences(
        players: List<Player>,
        answers: Map<GameStep, Map<String, String>>
    ): List<SentenceResult> {
        if (players.isEmpty()) return emptyList()

        val kimList = players.map { answers[GameStep.KIM]?.get(it.id).orEmpty() }
        val kiminleList = derange(players.map { answers[GameStep.KIMINLE]?.get(it.id).orEmpty() })
        val neredeList = derange(players.map { answers[GameStep.NEREDE]?.get(it.id).orEmpty() })
        val neYapiyorList = derange(players.map { answers[GameStep.NE_YAPIYOR]?.get(it.id).orEmpty() })

        return players.mapIndexed { i, player ->
            SentenceResult(
                readerName = player.name,
                kim = kimList[i],
                kiminle = kiminleList[i],
                nerede = neredeList[i],
                neYapiyor = neYapiyorList[i]
            )
        }
    }

    private fun derange(items: List<String>): List<String> {
        if (items.size <= 1) return items
        val indices = items.indices.toMutableList()
        var attempts = 0
        do {
            indices.shuffle()
            attempts++
        } while (indices.indices.any { indices[it] == it } && attempts < 50)

        if (indices.indices.any { indices[it] == it }) {
            return items.drop(1) + items.first()
        }
        return indices.map { items[it] }
    }
}

